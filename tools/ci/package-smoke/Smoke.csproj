<Project Sdk="Microsoft.NET.Sdk">

  <!-- An application that uses messagingForCore through its packages only (tools/ci/package-smoke.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="messagingForCore" Version="$(MessagingForCoreVersion)" />
  </ItemGroup>
</Project>
