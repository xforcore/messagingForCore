<Project Sdk="Microsoft.NET.Sdk">

  <!-- messagingforcore-msmq: prepares and manages messagingForCore's queue database (install, upgrade, create-queue,
       delete-queue, purge, list), as turning on MSMQ and Computer Management did. A .NET tool:
       dotnet tool install -g messagingForCore.Msmq (issue #1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>messagingforcore-msmq</AssemblyName>
    <RootNamespace>MessagingForCore.Msmq</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>messagingforcore-msmq</ToolCommandName>
    <PackageId>messagingForCore.Msmq</PackageId>
    <Description>messagingforcore-msmq: prepares messagingForCore's SQLite queue database (install, upgrade) and manages its private queues (create-queue, delete-queue, purge, list).</Description>
    <PackageTags>system.messaging;msmq;sqlite;messagingforcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\messagingForCore.System.Messaging\messagingForCore.System.Messaging.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>
</Project>
