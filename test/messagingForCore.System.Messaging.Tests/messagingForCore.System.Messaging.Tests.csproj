<Project Sdk="Microsoft.NET.Sdk">

  <!-- messagingForCore's own tests (CONTRIBUTING.md, principle 2): the queue store behind Microsoft's System.Messaging,
       through System.Messaging's public API, feature by feature. Each runs against a queue database of its own
       (TestDatabase.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MessagingForCore.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);SYSLIB0011;SYSLIB0050;SYSLIB0051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\messagingForCore.System.Messaging\messagingForCore.System.Messaging.csproj" />
    <ProjectReference Include="..\..\src\messagingForCore.Msmq\messagingForCore.Msmq.csproj" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

</Project>
